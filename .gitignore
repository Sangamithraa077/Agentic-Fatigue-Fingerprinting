# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
venv/
.venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Environment variables / secrets
.env
.env.*

# Data
datasets/raw/*
!datasets/raw/.gitkeep
datasets/raw/WSD4FEDSRM/
datasets/raw/WSD4FEDSRM.zip
datasets/processed/*
!datasets/processed/.gitkeep

# Trained model artifacts (regeneratable via notebooks/phase9_baseline_models_report.py;
# some RandomForest checkpoints exceed GitHub's 100MB per-file limit)
ml/models/artifacts/classical/*
!ml/models/artifacts/classical/.gitkeep
ml/models/artifacts/deep_learning/*
!ml/models/artifacts/deep_learning/.gitkeep

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Testing
.pytest_cache/
.coverage
htmlcov/
